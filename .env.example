# copy to .env to override; every value here is a development default

# docker compose
POSTGRES_USER=geo
POSTGRES_PASSWORD=geo
POSTGRES_DB=geo
POSTGRES_HOST_PORT=54329
API_PORT=8000
# POSTGIS_IMAGE=postgis/postgis:17-3.5

# application (GEOTRACK_*), used directly when running outside docker
GEOTRACK_DATABASE_URL=postgresql+asyncpg://geo:geo@localhost:54329/geo
GEOTRACK_REDIS_URL=redis://localhost:6379/0
GEOTRACK_LOG_LEVEL=INFO
GEOTRACK_DB_POOL_SIZE=10
GEOTRACK_DB_MAX_OVERFLOW=10
GEOTRACK_DB_STATEMENT_TIMEOUT_MS=5000
GEOTRACK_PIPELINE_CAPACITY=60000
GEOTRACK_PIPELINE_BATCH_SIZE=2000
GEOTRACK_PIPELINE_MAX_DELAY=0.1
GEOTRACK_MAX_GEOZONES_PER_USER=200
GEOTRACK_LIVE_PUSH_INTERVAL=1.0
GEOTRACK_LIVE_DEVICE_TTL_SECONDS=120
